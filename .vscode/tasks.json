{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Backend (uv)",
      "type": "shell",
      "command": "uv run uvicorn main:app --reload --host 0.0.0.0 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": "^ERROR:\\s+(.*)$",
            "message": 1
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Uvicorn running on.*",
          "endsPattern": ".*Application startup complete.*"
        }
      },
      "presentation": {
        "group": "servers",
        "panel": "new",
        "clear": true
      }
    },
    {
      "label": "Run Frontend (Node / Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": "^.*error.*$",
            "message": 0
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*ready.*",
          "endsPattern": ".*Network:.*"
        }
      },
      "presentation": {
        "group": "servers",
        "panel": "new",
        "clear": true
      }
    },
    {
      "label": "Build Frontend (Node)",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Install Backend Dependencies (uv sync)",
      "type": "shell",
      "command": "uv sync",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      }
    },
    {
      "label": "Install Frontend Dependencies (npm install)",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      }
    },
    {
      "label": "Start Full Stack (Backend + Frontend)",
      "dependsOn": [
        "Run Backend (uv)",
        "Run Frontend (Node / Vite)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
