# ==============================================================================
# MeetingAgent AI - DHBW Student Manager Configuration
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
# ==============================================================================

# Application Settings
APP_NAME="MeetingAgent AI - DHBW Student Manager"
APP_VERSION="0.2.0"
DEBUG=false
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------------------
# Production Security & Deployment
# ------------------------------------------------------------------------------
# Secret key for session encryption & tokens (auto-persists to data/.secret_key if left empty)
SECRET_KEY="generate-a-strong-random-key-for-production"

# Single-User Master Passphrase (enforces lockscreen and protected API endpoints)
# Leave empty for open access on localhost, or set a strong passphrase for public deployment:
APP_PASSWORD=""

# Allowed CORS Origins (comma-separated list for deployment, or "*" for dev)
# Example: ALLOWED_ORIGINS="https://dhbw-manager.yourdomain.com,http://localhost:8000"
ALLOWED_ORIGINS="*"


# ------------------------------------------------------------------------------
# Database Persistence
# ------------------------------------------------------------------------------
# Default: Local SQLite database in ./data/meetings.db
DATABASE_URL="sqlite:///./data/meetings.db"

# PostgreSQL (production ready):
# DATABASE_URL="postgresql://user:password@localhost:5432/meeting_agent"

# ------------------------------------------------------------------------------
# Google Workspace Integration (Calendar, Tasks, Drive)
# ------------------------------------------------------------------------------
# Get your OAuth 2.0 Web Client credentials at:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/google/oauth2callback"

# Automated Google Cloud Sync Flags (true/false)
GOOGLE_AUTO_SYNC_CALENDAR=false
GOOGLE_AUTO_SYNC_TASKS=true
GOOGLE_AUTO_SYNC_DRIVE=false

# ------------------------------------------------------------------------------
# AI Provider API Keys
# ------------------------------------------------------------------------------
# Google Gemini API Key (Recommended)
# Free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# OpenAI API Key (Optional)
OPENAI_API_KEY=""

# ------------------------------------------------------------------------------
# Engine & Model Configurations
# ------------------------------------------------------------------------------
TRANSCRIPTION_ENGINE="gemini"    # "gemini" | "local_whisper" | "openai"
SUMMARIZATION_ENGINE="gemini"    # "gemini" | "openai"
GEMINI_MODEL="gemini-2.0-flash"
OPENAI_MODEL="gpt-4o"
WHISPER_LOCAL_MODEL="base"       # For 100% offline transcription
AUDIO_LANGUAGE="auto"
SUMMARY_DETAIL="standard"
